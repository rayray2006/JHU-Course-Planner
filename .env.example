# Supabase — required. Service key is needed for writes and every ingest script.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Vertex AI — required for the chat agent (Gemini 2.5 Flash).
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=us-central1

# Production only: the full service-account JSON on one line.
# Locally, `gcloud auth application-default login` is enough.
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Only needed to re-scrape SIS (npm run ingest, npm run sync:seats).
# Request a key from the Course Search API page (linked from https://courses.jhu.edu/).
JHU_API_KEY=

# Base URL of the SIS Course Search Web API, without the trailing /classes.
# Defaults to https://sis.jhu.edu/api. Set this when the new Typesense-backed
# API is served from a different host; the request paths are unchanged.
JHU_SIS_API_BASE=

# Shared secret for /api/cron/sync-seats. Must match the value set in Vercel,
# or the daily cron silently 401s.
CRON_SECRET=

# Optional: only used by scripts that call Gemini directly (process-requirements).
GOOGLE_GENERATIVE_AI_API_KEY=
